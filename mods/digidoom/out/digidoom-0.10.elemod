{
 "elemod": 2,
 "id": "digidoom",
 "version": "0.10",
 "title": "DIGIDOOM",
 "description": "A compact DOOM-style raycaster for the Digitone mk1 / Keys screen (128x64, 1-bit), with a title -> play -> game-over flow (title: DOOM - KARL MARX EDITION). Survives the 128 KB elekloader mod budget by drawing with the firmware's own FILLRECT / VLINE / TEXTF. Arrow keys move and turn (FUNC strafes); YES fires (or starts/retries), NO uses (or exits). Toggle with MIDI+YES. Not the Doom engine: a from-scratch renderer in the spirit of the RP2040 tiny Doom builds.",
 "category": "Games",
 "author": "DIGIDOOM",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.43",
  "syx_sha256": "c5a54cc05b921f2e4bd814834c5365c2a5aa01d7772a9a2961fac1c3095bf9aa",
  "section3_sha256": "3831a477a2a22befb23c42e47e782853da49566ef5d0a1767fcf6c30e6767414",
  "section3_len": 2732208
 },
