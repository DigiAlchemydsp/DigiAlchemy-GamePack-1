{
 "elemod": 2,
 "id": "digidoom",
 "version": "0.1",
 "title": "DIGIDOOM",
 "description": "A compact DOOM-style raycaster for the Digitone mk1 / Keys screen (128x64, 1-bit). Survives the 128 KB elekloader mod budget by drawing its own framebuffer and overlaying it at panel present. Arrow keys move and turn; YES fires, NO uses. Toggle with MIDI+YES. Not the Doom engine: a from-scratch renderer in the spirit of the RP2040 tiny Doom builds.",
 "category": "Games",
 "author": "DIGIDOOM",
 "license": "GPL-2.0-or-later",
