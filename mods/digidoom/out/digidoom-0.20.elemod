{
 "elemod": 2,
 "id": "digidoom",
 "version": "0.20",
 "title": "DIGIDOOM",
 "description": "A tiny game launcher for the Digitone mk1 / Keys screen (128x64, 1-bit). Press MIDI+YES for a game-select menu (arrows + YES), then play DOOM (a from-scratch DOOM-style raycaster: ordered-dither walls, billboard sprites, HUD, weapon, doors, monsters; title reads DOOM - KARL MARX EDITION) or INVADERS (a very lightweight Space Invaders: a 6x4 fleet, ship, bullets, lives, score). Survives the 128 KB elekloader mod budget by drawing with the firmware's own FILLRECT / VLINE / TEXTF. Not the Doom engine.",
 "category": "Games",
 "author": "DIGIDOOM",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.43",
  "syx_sha256": "c5a54cc05b921f2e4bd814834c5365c2a5aa01d7772a9a2961fac1c3095bf9aa",
