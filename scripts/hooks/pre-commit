#!/bin/sh
# Pre-commit guard: block proprietary firmware and the third-party reference
# tree from ever being committed. Enable once with:
#
#     git config core.hooksPath scripts/hooks
#
staged=$(git diff --cached --name-only --diff-filter=ACM)

bad=$(printf '%s\n' "$staged" | grep -Ei '\.(syx|whx|whd)$' || true)
if [ -n "$bad" ]; then
    echo "error: refusing to commit firmware files (never redistribute firmware):" >&2
    printf '%s\n' "$bad" >&2
    exit 1
fi

if printf '%s\n' "$staged" | grep -q '^Smallest-Doom-rp2040/'; then
    echo "error: refusing to commit the third-party reference tree." >&2
    exit 1
fi

exit 0
